# Copia este archivo como `.env` (no se versiona) y ajusta los valores.
# Los valores por defecto coinciden con infra/docker-compose.dev.yml.

# PostgreSQL de desarrollo (Docker, puerto 5434 del host).
DATABASE_URL=postgres://bienestarpro:bienestarpro_dev@127.0.0.1:5434/bienestarpro

# Secreto de firma de JWT (genera uno propio con: python3 -c "import secrets; print(secrets.token_hex(32))").
JWT_SECRET=cambia-este-secreto

# Vida del token de acceso en segundos (15 minutos por defecto).
JWT_ACCESS_TTL=900

# Clave de cifrado de los secretos TOTP (hex de 32 bytes).
# Genera una con: python3 -c "import secrets; print(secrets.token_hex(32))"
TOTP_ENCRYPTION_KEY=cambia-esta-clave-hex-de-64-caracteres

# Puerto de la API.
PORT=3001

# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173
