{
  "name": "@bienestarpro/api",
  "private": true,
  "version": "0.1.0",
  "description": "API core de BienestarPro (NestJS + Fastify) — monolito modular por dominios",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@bienestarpro/contracts": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.0",
    "otplib": "^13.5.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.87.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
