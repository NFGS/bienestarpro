# Copia este archivo como `.env` (chmod 600) y rellena los valores.
# El `.env` real de este equipo se generó desde el contenedor en ejecución el
# 2026-10-09; nunca lo versiones.

# Clave de cifrado de credenciales. Si la cambias, las credenciales guardadas
# dejan de funcionar.
OPEN_NOTEBOOK_ENCRYPTION_KEY=cambia-esta-clave-de-cifrado

# Credenciales de SurrealDB (se usan en ambos servicios).
SURREAL_USER=root
SURREAL_PASSWORD=cambia-esta-contrasena
SURREAL_BIND=0.0.0.0:8000

# La app usa red host, así que SurrealDB se alcanza por loopback.
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# Contraseña de la interfaz web (opcional en la práctica).
APP_PASSWORD=